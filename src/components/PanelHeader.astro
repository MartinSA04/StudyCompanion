---
import { renderMathString } from "../lib/katex.ts";

/**
 * The shared header bar that sits at the top of a bordered panel — one card-tinted
 * strip with a bottom hairline, a leading mark (a mono kicker badge or an accent
 * dot) and an optional display title. Extracted so `<Example>` and `<Simulation>`
 * stop re-implementing slightly-drifting copies of the same bar.
 *
 * Slots: `kicker-icon` sits inside the kicker badge (kept as one chip); the
 * default slot is trailing content. `title` may contain `$inline$` math.
 *
 * Not author-facing (not in mdx-components) — an internal layout primitive.
 * Deliberately NOT used by `<CodeBlock>` (a lighter mono filename strip) or the
 * FormulaSheet group heading (a heading above a list, not a panel bar).
 */
interface Props {
  /** Mono uppercase badge text (e.g. "Regneeksempel"). */
  kicker?: string;
  /** A leading accent dot instead of a kicker badge. */
  dot?: boolean;
  /** Display title text; may contain `$inline$` math. */
  title?: string;
  titleSize?: "md" | "lg";
  /** Cross-axis alignment: "baseline" pairs a badge with a title; "center" suits a dot. */
  align?: "baseline" | "center";
}
const {
  kicker,
  dot = false,
  title,
  titleSize = "md",
  align = "baseline",
} = Astro.props;
---

<div class={`panel-head align-${align}`}>
  {
    /* The mark and the title share ONE inline box, so the mark reads as the
      first word of the title rather than as a column beside it. */
  }
  <span class="panel-lead">
    {dot && <span class="panel-dot" aria-hidden="true" />}
    {
      kicker && (
        <span class="panel-kicker sc-kicker">
          <slot name="kicker-icon" />
          {kicker}
        </span>
      )
    }
    {
      title && (
        <span
          class={`panel-title size-${titleSize}`}
          set:html={renderMathString(title)}
        />
      )
    }
  </span>
  <slot />
</div>

<style>
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--card);
    border-bottom: 1px solid var(--border);
    /* Follow the host panel's top rounding, so panels don't need
       overflow:hidden (which clips descendant focus outlines) to keep this
       tinted strip inside their corners. */
    border-start-start-radius: inherit;
    border-start-end-radius: inherit;
  }
  .align-baseline {
    align-items: baseline;
  }
  .align-center {
    align-items: center;
  }
  /* Mark + title in one inline run. Two things fall out of this that a flex row
     could not give at once: the mark can never be stranded on a line of its own
     (it is inside the text's own box, not a sibling competing for flex lines),
     and a title that wraps starts its second line at the LEFT EDGE, under the
     mark — instead of hanging in a narrow column beside it. A zero flex basis
     keeps the whole run out of the outer row's line-packing. */
  .panel-lead {
    flex: 1 1 0;
    min-width: 0;
    line-height: var(--leading-snug);
  }
  /* Mono/uppercase/tracking/semibold recipe comes from the shared .sc-kicker;
     the header only sets the badge's layout, size and tone. */
  .panel-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* An inline-flex box with no baseline-aligned child synthesizes its
       baseline from its bottom edge, which would drop the badge below the
       title's baseline; centring it on the x-height reads level instead. */
    vertical-align: middle;
    margin-inline-end: var(--space-3);
    font-size: var(--text-sm);
    color: var(--accent-ink);
  }
  .panel-dot {
    display: inline-block;
    vertical-align: middle;
    margin-inline-end: var(--space-3);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .panel-title {
    /* Inline on purpose (see .panel-lead) — it is a run of text that happens to
       follow a mark, not a column. */
    font-family: var(--font-display);
    color: var(--fg);
  }
  .panel-title.size-md {
    font-weight: var(--weight-medium);
    font-size: var(--text-md);
  }
  .panel-title.size-lg {
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
  }
</style>
