---
import Icon from "./Icon.astro";
import { renderMathString } from "../lib/katex.ts";
import { slugify } from "../lib/slug.ts";
import { assertOneOf } from "../lib/assertProp.ts";

/**
 * A named, boxed result — a law, theorem, definition or principle ("Snells lov",
 * "Huygens' prinsipp"). Gives recurring named results a consistent treatment and
 * a STABLE `id` anchor for deep-linking (and for the <FormulaRef>/glossary
 * cross-refs). The `id` is derived from `name` (slugified) unless given
 * explicitly. `name` may contain `$inline$` math; the body is slotted MDX.
 */
interface Props {
  kind?: "law" | "theorem" | "definition" | "principle";
  name: string;
  /** Anchor id. Defaults to a slug of `name`. */
  id?: string;
}
const { kind = "definition", name, id } = Astro.props;

const LABELS = {
  law: "Lov",
  theorem: "Teorem",
  definition: "Definisjon",
  principle: "Prinsipp",
} as const;
// MDX isn't type-checked: a typo'd kind would otherwise ship a blank badge
// with aria-label={undefined}.
assertOneOf(kind, Object.keys(LABELS), "Statement", "kind");

const anchor = id ?? slugify(name);
---

<aside
  class={`statement statement-${kind}`}
  id={anchor}
  role="note"
  tabindex="-1"
  aria-label={LABELS[kind]}
>
  <p class="statement-head">
    {
      /* Badge and name share ONE inline box (see PanelHeader): the badge reads as
        the first word of the name, and a name that wraps returns to the left
        edge under it instead of stacking in a column beside it. */
    }
    <span class="statement-lead">
      <span class="statement-badge sc-kicker">
        <Icon name="bookmark" size={15} />
        {LABELS[kind]}
      </span>
      <span class="statement-name" set:html={renderMathString(name)} />
    </span>
    <a
      class="statement-anchor"
      href={`#${anchor}`}
      aria-label="Lenke til dette resultatet">#</a
    >
  </p>
  <div class="statement-body"><slot /></div>
</aside>

<style>
  .statement {
    margin-block: var(--space-5);
    padding: var(--space-4);
    background: var(--accent-soft);
    border-radius: var(--radius);
    scroll-margin-top: calc(var(--topbar-h) + var(--space-3));
  }
  /* Flash on deep-link arrival, same as <FormulaRef>/<Term> row targets. It
     settles back to the statement's own accent-soft ground. */
  .statement:target {
    animation: sc-target-flash var(--dur-flash) var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .statement:target {
      animation: none;
    }
  }
  .statement-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-2);
  }
  /* One inline run holding the badge and the name — see the note in the markup.
     The zero flex basis keeps it out of the head row's line-packing, so the "#"
     can never be pushed onto a line of its own. */
  .statement-lead {
    flex: 1 1 0;
    min-width: 0;
    line-height: var(--leading-snug);
  }
  /* Mono uppercase kicker recipe comes from .sc-kicker; layout + tone local. */
  .statement-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* Centred, not baseline-aligned: an inline-flex box with no baseline-aligned
       child synthesizes its baseline from its bottom edge and would sit low. */
    vertical-align: middle;
    margin-inline-end: var(--space-3);
    font-size: var(--text-sm);
    /* --accent-ink keeps the kicker AA on the accent-soft ground in both themes
       (raw --accent is only 3.89:1 in dark). The bookmark icon inherits it via
       currentColor, so the kicker stays one uniform accent unit. */
    color: var(--accent-ink);
  }
  .statement-name {
    /* Inline on purpose (see .statement-lead) — a run of text following the
       badge, not a column beside it. */
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    color: var(--fg);
  }
  .statement-anchor {
    /* Baseline-aligned with the name's FIRST line (the head row is
       align-items: baseline), so on a name that wraps the "#" stays up beside
       the start of the text instead of drifting to the middle of the block. */
    flex: none;
    padding-inline: var(--space-1);
    color: var(--muted);
    font-family: var(--font-mono);
    text-decoration: none;
    opacity: 0.5;
    transition:
      opacity var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .statement:hover .statement-anchor,
  .statement-anchor:focus-visible {
    opacity: 1;
    color: var(--accent-ink);
  }
  .statement-body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
