---
/**
 * Multiple-choice question (vanilla island). `answer` is the 0-based index of
 * the right option — or an array of indices when several options are right.
 *
 * Single answer: radio-style rows, and the click grades at once. Several
 * answers: the rows are checkboxes (square marks, the convention readers
 * already know from every form), the reader ticks any number and presses
 * «Sjekk svar»; grading then marks each row as chosen-and-right,
 * chosen-and-wrong or missed. This is a study aid, not a graded test, so the
 * answer being present in the DOM is fine.
 *
 * No structured data: Google retired the practice-problem rich result this
 * once emitted (schema.org `Quiz`) in January 2026, so the markup would only
 * restate the form for no reader. The flashcard deck's Education Q&A markup
 * stays — Google still documents that one (see lib/jsonLd.ts).
 */
interface Props {
  question: string;
  options: string[];
  /** 0-based index of the right option, or the indices of every right one. */
  answer: number | number[];
  explanation?: string;
}
const { question, options, answer, explanation } = Astro.props;
import { renderMathString } from "../lib/katex.ts";
import { mathStringToText } from "../lib/mathText.ts";
import Icon from "./Icon.astro";

const multi = Array.isArray(answer);
const answers = multi ? answer : [answer];

// Build-time guard: an out-of-range/fractional/duplicate answer would ship a
// quiz no choice can ever grade "riktig" — fail the build naming the question.
const valid =
  answers.length > 0 &&
  new Set(answers).size === answers.length &&
  answers.every((a) => Number.isInteger(a) && a >= 0 && a < options.length);
if (!valid) {
  throw new Error(
    `study-companion: <Quiz question="${question}"> has answer=${JSON.stringify(answer)}, ` +
      `which is not ${multi ? "a non-empty list of distinct indices" : "an index"} ` +
      `into its ${options.length} options (0–${options.length - 1}).`,
  );
}

// Accessible names, as plain text. Chrome leaves KaTeX's MathML out of a
// control's name (and a group's, from its legend), so "Bølgelengden $\lambda$
// blir kortere" would be announced as "Bølgelengden blir kortere". The option
// labels are also what the graded live region reads back (script below).
const hint = "Flere svar er riktige. Kryss av alle som stemmer.";
const groupLabel = mathStringToText(question) + (multi ? ` ${hint}` : "");
const optionLabels = options.map(mathStringToText);
---

<form
  class="quiz sc-panel"
  data-answer={answers.join(",")}
  data-multi={multi ? "" : undefined}
>
  <fieldset aria-label={groupLabel}>
    {
      /* The hint shows under the question and ends the group's name
        (groupLabel), so a screen reader hears "…? Flere svar er riktige"
        before the first checkbox. */
    }
    <legend class="quiz-q">
      <span set:html={renderMathString(question)} />
      {multi && <span class="quiz-hint">{hint}</span>}
    </legend>
    <ul class="quiz-options">
      {
        options.map((opt, i) => (
          <li>
            <button
              type="button"
              class="quiz-option"
              data-index={i}
              role={multi ? "checkbox" : undefined}
              aria-checked={multi ? "false" : undefined}
              aria-label={optionLabels[i]}
            >
              <span class="quiz-mark" aria-hidden="true">
                <Icon name="check" size={13} class="i-correct" />
                <Icon name="x" size={13} class="i-wrong" />
              </span>
              {/* tabindex="-1": a wide formula makes this span a scroll
                  container, and Chrome then gives it a Tab stop of its own
                  INSIDE the button — Enter there grades with focus stranded in
                  a disabled button. -1 keeps it out of the Tab order; the
                  script hands a click's focus back to the button and lets ←/→
                  on the button scroll it. */}
              <span
                class="quiz-text"
                tabindex="-1"
                set:html={renderMathString(opt)}
              />
            </button>
          </li>
        ))
      }
    </ul>
    {
      multi && (
        <button type="button" class="quiz-submit sc-btn sc-press" disabled>
          Sjekk svar
        </button>
      )
    }
  </fieldset>
  <p
    class="quiz-feedback"
    role="status"
    aria-live="polite"
    tabindex="-1"
    hidden
  >
  </p>
  {
    explanation && (
      <p class="quiz-explain" set:html={renderMathString(explanation)} hidden />
    )
  }
</form>

<style>
  /* Float (fill + shadow + radius) comes from the shared .sc-panel; fill is now
     --bg-elevated (was --card — identical colour, one token for float surfaces). */
  .quiz {
    margin-block: var(--space-5);
    padding: var(--space-4);
  }
  .quiz fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    /* UA default is min-width: min-content, so one wide formula option would
       push the whole fieldset (question included) out past the panel. */
    min-width: 0;
  }
  .quiz-q {
    font-weight: var(--weight-semibold);
    padding: 0;
    margin-bottom: var(--space-3);
  }
  .quiz-hint {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--muted);
  }
  .quiz-options {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* A column-flex item's min-width is auto, i.e. its content's min width, so
     one wide formula option would widen the list past the panel and clip the
     question. 0 makes .quiz-text's scroll box the thing that gives instead. */
  .quiz-options > li {
    min-width: 0;
  }
  /* Borderless filled rows: each option recesses to --card-nested inside the
     --bg-elevated panel (like every other inset), so the resting affordance is a
     fill — the SAME modality as the graded --tip-bg / --wrong-bg tints, making
     rest→graded one coherent fill change. The radio mark keeps the only border
     (the sanctioned --border-strong form glyph — see the Structural-Border
     Rule), so the rows still read as selectable choices. */
  .quiz-option {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-align: left;
    padding: var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--card-nested);
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  /* Accent wash carries the interactive cue the border used to (blended into the
     resting fill so it stays visible in both themes — --card-hover == the resting
     --card-nested, so a plain fill hover would be invisible). */
  .quiz-option:hover:not([disabled]) {
    background: color-mix(in srgb, var(--accent) 14%, var(--card-nested));
  }
  /* Tactile press, kept local (not the shared .sc-press): a graded option is
     [disabled], and the :not([disabled]) guard must suppress the press there. */
  .quiz-option:active:not([disabled]) {
    transform: translateY(1px);
  }
  /* The option text is the row's flexible cell: flex-basis 0 (not min-width:0
     alone) so a long option never strands the mark on its own line. An option
     that is a formula must not break inside itself — inline KaTeX is a run of
     .base spans a browser will wrap between, after an `=` or a comma, and the
     option then reads as two formulas (maintainer call, 2026-09-20: a
     scrollbar is fine, a bad break is not). Keep the math on one line and let
     this cell scroll it; prose options still wrap at spaces as before. */
  .quiz-text {
    flex: 1 1 0;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .quiz-text :global(.katex) {
    white-space: nowrap;
  }
  .quiz-mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.3em;
    height: 1.3em;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
  }
  /* Several right answers: square marks, the checkbox shape every form has
     taught readers means "tick any number", against the round radio for one. */
  .quiz[data-multi] .quiz-mark {
    border-radius: var(--radius-xs);
  }
  /* Both result glyphs are present but hidden until the option is graded, so
     correct/wrong reads from the shape (check / cross), not colour alone. */
  .quiz-mark :global(.i-correct),
  .quiz-mark :global(.i-wrong) {
    display: none;
  }
  /* A ticked (not yet graded) checkbox: accent-filled square with the check,
     and an accent wash on the row so the selection reads from across the room. */
  .quiz-option[aria-checked="true"] {
    background: color-mix(in srgb, var(--accent) 14%, var(--card-nested));
  }
  .quiz-option[aria-checked="true"] .quiz-mark {
    background: var(--accent);
    border-color: var(--accent);
  }
  .quiz-option[aria-checked="true"] .quiz-mark :global(.i-correct) {
    display: block;
    color: var(--on-strong);
  }
  .quiz-option[data-state="correct"] {
    background: var(--tip-bg);
    color: var(--tip);
  }
  .quiz-option[data-state="correct"] .quiz-mark {
    background: var(--tip);
    border-color: var(--tip);
  }
  .quiz-option[data-state="correct"] .quiz-mark :global(.i-correct) {
    display: block;
    color: var(--on-strong);
  }
  /* A right answer the reader did not tick: same green row, but a hollow mark
     with a green check — "this one too", distinct from the filled tick they
     chose themselves. */
  .quiz-option[data-state="missed"] {
    background: var(--tip-bg);
    color: var(--tip);
  }
  .quiz-option[data-state="missed"] .quiz-mark {
    border-color: var(--tip);
  }
  .quiz-option[data-state="missed"] .quiz-mark :global(.i-correct) {
    display: block;
    color: var(--tip);
  }
  .quiz-option[data-state="wrong"] {
    background: var(--wrong-bg);
    color: var(--wrong);
  }
  .quiz-option[data-state="wrong"] .quiz-mark {
    background: transparent;
    border-color: var(--wrong);
  }
  .quiz-option[data-state="wrong"] .quiz-mark :global(.i-correct) {
    display: none;
  }
  .quiz-option[data-state="wrong"] .quiz-mark :global(.i-wrong) {
    display: block;
    color: var(--wrong);
  }
  /* Same recessed fill as the option rows (the shared .sc-btn paper fill
     equals this panel's own, and would vanish into it), so it reads as one
     more control of the group; the accent wash on hover matches the rows. */
  .quiz-submit {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--card-nested);
    color: var(--fg);
  }
  .quiz-submit:hover:not([disabled]) {
    background: color-mix(in srgb, var(--accent) 14%, var(--card-nested));
    color: var(--accent-ink);
  }
  .quiz-submit[disabled] {
    color: var(--muted);
    cursor: not-allowed;
    transform: none;
  }
  .quiz-feedback {
    margin-top: var(--space-3);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
  }
  .quiz-feedback[data-result="correct"] {
    color: var(--tip);
  }
  .quiz-feedback[data-result="wrong"] {
    color: var(--wrong);
  }
  .quiz-explain {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: var(--leading-snug);
    padding: var(--space-3) var(--space-4);
    background: var(--accent-soft);
    border-radius: var(--radius);
  }
</style>

<script>
  import { onPage } from "../lib/pageLifecycle.ts";
  onPage((signal) => {
    document.querySelectorAll<HTMLFormElement>(".quiz").forEach((quiz) => {
      const answers = new Set(
        (quiz.dataset.answer ?? "").split(",").map(Number),
      );
      const multi = "multi" in quiz.dataset;
      const options = [
        ...quiz.querySelectorAll<HTMLButtonElement>(".quiz-option"),
      ];
      const submit = quiz.querySelector<HTMLButtonElement>(".quiz-submit");
      const feedback = quiz.querySelector<HTMLElement>(".quiz-feedback")!;
      const explain = quiz.querySelector<HTMLElement>(".quiz-explain");
      let done = false;

      // Each option's plain-text name, built at build time (aria-label, see
      // the frontmatter) — the one source for the announced feedback too.
      const labels = options.map((b) => b.getAttribute("aria-label") ?? "");

      // State suffix on the accessible name, so a graded option says what the
      // colour + icon show ("…, riktig svar" / "…, ditt svar").
      const addSrState = (i: number, text: string) => {
        options[i].setAttribute("aria-label", `${labels[i]}, ${text}`);
      };

      options.forEach((btn, i) => {
        // The text span is a tabindex=-1 scroller (see the markup): a click on
        // it would focus the span, not the button, so hand focus back.
        const text = btn.querySelector<HTMLElement>(".quiz-text");
        text?.addEventListener(
          "focus",
          () => btn.focus({ preventScroll: true }),
          { signal },
        );
        // ↑/↓ moves focus between options (arrow-key group navigation); ←/→
        // scroll an option too wide for its row, which takes no focus itself —
        // and, like Stepper's arrows, stop there instead of reaching the
        // page's global ←/→ module paging. An option that fits leaves ←/→ to
        // the paging, as before.
        btn.addEventListener(
          "keydown",
          (e) => {
            if (e.key === "ArrowDown") {
              e.preventDefault();
              options[(i + 1) % options.length]?.focus();
            } else if (e.key === "ArrowUp") {
              e.preventDefault();
              options[(i - 1 + options.length) % options.length]?.focus();
            } else if (
              (e.key === "ArrowRight" || e.key === "ArrowLeft") &&
              text &&
              text.scrollWidth > text.clientWidth
            ) {
              e.preventDefault();
              e.stopPropagation();
              text.scrollBy({ left: e.key === "ArrowRight" ? 40 : -40 });
            }
          },
          { signal },
        );
      });

      // Grade a set of chosen indices: every option ends up right (chosen and
      // in the key), wrong (chosen, not in the key), missed (in the key, not
      // chosen — only possible with several answers) or plain (neither).
      const grade = (chosen: Set<number>) => {
        if (done) return;
        done = true;
        const correct =
          chosen.size === answers.size &&
          [...chosen].every((c) => answers.has(c));

        // Disabling every option (including a focused one) would blur focus
        // to <body>. If an option had focus, hand it to the feedback line
        // instead so keyboard users keep a landing spot; pointer users never
        // had widget focus, so they're untouched.
        const hadFocus = [...options, submit].includes(
          document.activeElement as HTMLButtonElement,
        );

        options.forEach((b, i) => {
          b.disabled = true;
          if (answers.has(i) && (chosen.has(i) || !multi)) {
            b.dataset.state = "correct";
            addSrState(i, "riktig svar");
          } else if (answers.has(i)) {
            b.dataset.state = "missed";
            addSrState(i, "riktig svar, ikke valgt");
          } else if (chosen.has(i)) {
            b.dataset.state = "wrong";
            addSrState(i, "ditt svar");
          }
        });
        if (submit) submit.disabled = true;

        feedback.hidden = false;
        feedback.dataset.result = correct ? "correct" : "wrong";
        if (correct) {
          feedback.textContent = "Riktig!";
        } else {
          // Two audiences, one clean sentence each: sighted readers get
          // "Se riktig svar." (the green rows above show the answer, so
          // repeating it visibly is redundant); the live region announces
          // the answer by name instead, since the row's reveal is colour +
          // an aria-hidden icon — invisible in an announcement. aria-hidden
          // strips the pointer sentence from the announced text; sr-only
          // text is announced but not shown.
          feedback.textContent = "Ikke helt. ";
          const answerText = [...answers]
            .sort((a, b) => a - b)
            .map((a) => labels[a])
            .filter(Boolean)
            .join("; ");
          const pointer = document.createElement("span");
          pointer.textContent = multi ? "Se riktige svar." : "Se riktig svar.";
          if (answerText) {
            pointer.setAttribute("aria-hidden", "true");
            const sr = document.createElement("span");
            sr.className = "sr-only";
            sr.textContent = `${multi ? "Riktige svar" : "Riktig svar"}: ${answerText}.`;
            feedback.append(pointer, sr);
          } else {
            feedback.append(pointer);
          }
        }
        if (explain) explain.hidden = false;
        if (hadFocus) feedback.focus({ preventScroll: true });
      };

      if (multi) {
        // Checkbox rows: a click toggles; «Sjekk svar» grades the ticked set
        // and stays disabled until something is ticked, so there is nothing to
        // submit by accident.
        const ticked = () =>
          new Set(
            options
              .filter((b) => b.getAttribute("aria-checked") === "true")
              .map((b) => Number(b.dataset.index)),
          );
        options.forEach((btn) => {
          btn.addEventListener(
            "click",
            () => {
              if (done) return;
              const on = btn.getAttribute("aria-checked") === "true";
              btn.setAttribute("aria-checked", on ? "false" : "true");
              if (submit) submit.disabled = ticked().size === 0;
            },
            { signal },
          );
        });
        submit?.addEventListener("click", () => grade(ticked()), { signal });
      } else {
        options.forEach((btn) => {
          btn.addEventListener(
            "click",
            () => grade(new Set([Number(btn.dataset.index)])),
            { signal },
          );
        });
      }
    });
  });
</script>
